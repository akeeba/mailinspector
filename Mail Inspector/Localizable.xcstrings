    "No result from a trusted authentication server is available for %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für %@ liegt kein Ergebnis von einem vertrauenswürdigen Authentifizierungsserver vor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Δεν υπάρχει διαθέσιμο αποτέλεσμα από έμπιστο διακομιστή πιστοποίησης για %@."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No result from a trusted authentication server is available for %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay ningún resultado disponible de un servidor de autenticación de confianza para %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun résultat provenant d’un serveur d’authentification fiable n’est disponible pour %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Er is geen resultaat van een vertrouwde authenticatieserver beschikbaar voor %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não está disponível nenhum resultado de um servidor de autenticação fiável para %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ için güvenilir bir kimlik doğrulama sunucusundan sonuç bulunmuyor."
          }
        }
      }
    },
    "No trusted servers configured. Authentication results will be shown as Unknown until you add one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Keine vertrauenswürdigen Server konfiguriert. Authentifizierungsergebnisse werden bis zum Hinzufügen eines Servers als „Unbekannt“ angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Δεν έχουν διαμορφωθεί έμπιστοι διακομιστές. Τα αποτελέσματα πιστοποίησης θα εμφανίζονται ως Άγνωστα έως ότου προσθέσετε έναν."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No trusted servers configured. Authentication results will be shown as Unknown until you add one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No hay servidores de confianza configurados. Los resultados de autenticación se mostrarán como Desconocido hasta que añadas uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun serveur fiable n’est configuré. Les résultats d’authentification seront affichés comme Inconnu jusqu’à ce que vous en ajoutiez un."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geen vertrouwde servers geconfigureerd. Authenticatieresultaten worden weergegeven als 'Onbekend' totdat je er een toevoegt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não há servidores fiáveis configurados. Os resultados de autenticação serão apresentados como Desconhecido até adicionar um."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Güvenilen sunucu yapılandırılmadı. Bir sunucu ekleyene kadar kimlik doğrulama sonuçları Bilinmiyor olarak gösterilir."
          }
        }
      }
    },
    "No valid From address could be parsed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es konnte keine gültige From-Adresse ermittelt werden."
