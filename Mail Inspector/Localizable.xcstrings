        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rechtstreeks slepen vanuit de berichtenlijst van Apple Mail naar dit venster wordt door macOS niet ondersteund – zet het bericht in plaats daarvan op het Dock-pictogram."
