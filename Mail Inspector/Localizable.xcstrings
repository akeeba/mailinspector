      }
    },
    "Dragging directly from Apple Mail's message list onto this window isn't supported by macOS — drop it on the Dock icon instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das direkte Ziehen aus der Nachrichtenliste von Apple Mail auf dieses Fenster wird von macOS nicht unterstützt — lege sie stattdessen auf dem Dock-Symbol ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Η απευθείας μεταφορά από τη λίστα μηνυμάτων του Apple Mail σε αυτό το παράθυρο δεν υποστηρίζεται από το macOS – αποθέστε το στο εικονίδιο του Dock."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
