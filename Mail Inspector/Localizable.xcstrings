    "The page size used when exporting or sharing the report as a PDF. The report is automatically paginated to fit, with a page number in the footer of each page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Seitengröße, die beim Exportieren oder Teilen des Berichts als PDF verwendet wird. Der Bericht wird automatisch passend umbrochen, mit einer Seitenzahl in der Fußzeile jeder Seite."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Το μέγεθος σελίδας που χρησιμοποιείται κατά την εξαγωγή ή την κοινή χρήση της αναφοράς ως PDF. Η αναφορά σελιδοποιείται αυτόματα ώστε να χωράει, με αριθμό σελίδας στο υποσέλιδο κάθε σελίδας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The page size used when exporting or sharing the report as a PDF. The report is automatically paginated to fit, with a page number in the footer of each page."
          }
