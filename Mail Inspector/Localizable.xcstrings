    "Messages larger than this are rejected before parsing, to bound memory use for untrusted input." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nachrichten, die größer sind als dieser Wert, werden vor dem Parsen abgelehnt, um die Speichernutzung bei nicht vertrauenswürdigen Eingabedaten zu begrenzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Τα μηνύματα που υπερβαίνουν αυτό το μέγεθος απορρίπτονται πριν από την ανάλυση, ώστε να περιορίζεται η χρήση μνήμης για μη αξιόπιστα δεδομένα εισόδου."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Messages larger than this are rejected before parsing, to bound memory use for untrusted input."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los mensajes más grandes que este tamaño se rechazan antes del análisis, para limitar el uso de memoria con datos de entrada no confiables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les messages plus volumineux que cette taille sont rejetés avant l’analyse, afin de limiter l’utilisation de la mémoire pour des données non fiables."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berichten die groter zijn dan deze waarde worden geweigerd vóór het parseren, om het geheugengebruik bij niet-vertrouwde invoer te beperken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As mensagens maiores do que este limite são rejeitadas antes da análise, para limitar o uso de memória com dados não fiáveis."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bundan daha büyük iletiler, güvenilmeyen girdilerde bellek kullanımını sınırlamak amacıyla ayrıştırılmadan önce reddedilir."
          }
        }
      }
    },
