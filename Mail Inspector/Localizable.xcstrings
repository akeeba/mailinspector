    "Drag an .eml file from Finder here, or drop a message onto this app's Dock icon." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ziehe eine .eml-Datei aus dem Finder hierhin oder lege eine Nachricht auf dem Dock-Symbol dieser App ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Σύρετε ένα αρχείο .eml από το Finder εδώ ή αποθέστε ένα μήνυμα στο εικονίδιο του Dock αυτής της εφαρμογής."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Drag an .eml file from Finder here, or drop a message onto this app’s Dock icon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrastra aquí un archivo .eml desde el Finder, o suelta un mensaje en el icono del Dock de esta aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Faites glisser un fichier .eml depuis le Finder ici, ou déposez un message sur l’icône du Dock de cette application."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sleep een .eml-bestand hierheen vanuit Finder, of zet een bericht op het Dock-pictogram van deze app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
