    "As reported by %@ (%@) — your mail provider's filter computed this, not this app. It is not a guarantee of safety." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Laut %1$@ (%2$@) – das wurde vom Filter deines E-Mail-Anbieters berechnet, nicht von dieser App. Es ist keine Garantie für Sicherheit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Σύμφωνα με %1$@ (%2$@) – αυτό υπολογίστηκε από το φίλτρο του παρόχου email σας, όχι από αυτήν την εφαρμογή. Δεν αποτελεί εγγύηση ασφάλειας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "As reported by %1$@ (%2$@) — your mail provider's filter computed this, not this app. It is not a guarantee of safety."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As reported by %1$@ (%2$@) – your mail provider’s filter computed this, not this app. It is not a guarantee of safety."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Según %1$@ (%2$@) — esto lo ha calculado el filtro del proveedor de correo, no esta aplicación. No es una garantía de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Signalé par %1$@ (%2$@) – c’est le filtre de votre fournisseur de messagerie qui a calculé ce résultat, pas cette application. Ce n’est pas une garantie de sécurité."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Volgens %1$@ (%2$@) – dit is berekend door het filter van je e-mailprovider, niet door deze app. Het is geen garantie voor veiligheid."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Segundo %1$@ (%2$@) – isto foi calculado pelo filtro do fornecedor de correio eletrónico, não por esta aplicação. Não é uma garantia de segurança."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bunu %1$@ bildirmiştir (%2$@) — bu sonucu e-posta sağlayıcınızın filtresi hesapladı, bu uygulama değil. Bir güvenlik garantisi değildir."
          }
        }
      }
    },
