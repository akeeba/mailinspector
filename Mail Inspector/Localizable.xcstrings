    "An AI opinion, not a verdict — it can be confidently wrong. Always weigh it against the signals above." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Meinung der AI, kein Urteil – sie kann sich mit großer Überzeugung irren. Sie sollte stets gegen die oben genannten Hinweise abgewogen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Μια γνώμη της AI, όχι ετυμηγορία – μπορεί να είναι λανθασμένη με αυτοπεποίθηση. Σταθμίστε την πάντα σε σχέση με τις παραπάνω ενδείξεις."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "An AI opinion, not a verdict – it can be confidently wrong. Always weigh it against the signals above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una opinión de la AI, no un veredicto — puede equivocarse con total seguridad. Pondérala siempre junto con las señales anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un avis de l’AI, pas un verdict – il peut se tromper avec une grande assurance. Évaluez-le toujours au regard des signaux ci-dessus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een AI-mening, geen oordeel – die kan vol overtuiging mis zijn. Weeg die altijd af tegen de signalen hierboven."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma opinião da AI, não um veredicto – pode estar errada com toda a confiança. Pondere-a sempre em conjunto com os sinais indicados acima."
          }
        },
        "tr" : {
          "stringUnit" : {
