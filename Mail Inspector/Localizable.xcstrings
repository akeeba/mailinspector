        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Arrastrar directamente desde la lista de mensajes de Apple Mail hasta esta ventana no es compatible con macOS — suéltalo en el icono del Dock en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le glisser-déposer direct depuis la liste des messages d’Apple Mail vers cette fenêtre n’est pas pris en charge par macOS — déposez-le plutôt sur l’icône du Dock."
